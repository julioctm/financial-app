# Supabase (Project Settings > API). Both are safe to expose to the browser;
# security comes from Row Level Security, not from hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public URL of the app (used for auth redirects). Local default shown.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
